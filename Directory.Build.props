<Project>
  <PropertyGroup>
    <!-- SDK root is three levels up from each sample .vcxproj -->
    <SdkRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)\..\..\..'))</SdkRoot>
    <SdkLibDir>$(SdkRoot)\lib</SdkLibDir>
    <!-- Use the 'd' suffixed library for Debug builds -->
    <SdkApiLib Condition="'$(Configuration)'=='Debug'">datalogics_interface_apid.lib</SdkApiLib>
    <SdkApiLib Condition="'$(Configuration)'!='Debug'">datalogics_interface_api.lib</SdkApiLib>
  </PropertyGroup>

  <!-- Add the SDK lib directory to PATH so the DLL and APDFL plugins are
       found at runtime.  Set the working directory to the SDK lib directory
       so that Library::get_resource_directory() resolves Resources/ correctly.
       This applies when launching from Visual Studio (F5 / Ctrl+F5). -->
  <PropertyGroup>
    <LocalDebuggerEnvironment>PATH=$(SdkLibDir);%PATH%</LocalDebuggerEnvironment>
    <LocalDebuggerWorkingDirectory>$(SdkLibDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>

  <!-- Override the library name so all samples link the correct variant -->
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>$(SdkApiLib);%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(SdkLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <ClCompile>
      <AdditionalIncludeDirectories>$(SdkRoot)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Samples use portable CRT functions (e.g. std::getenv); keep SDL
           checks from promoting C4996 deprecation warnings to errors. -->
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
